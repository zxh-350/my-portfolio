---
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/paths';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, date, source, problem, tags } = note.data;

const dateText = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<Layout title={title} description={note.data.summary}>
  <article>
    <nav class="text-xs text-slate-500">
      <a class="hover:text-slate-300" href={withBase('/notes')}>← 算法笔记</a>
    </nav>

    <header class="mt-4 border-b border-ink-800 pb-5">
      <h1 class="text-xl leading-snug font-semibold text-slate-100 sm:text-2xl">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
        <time datetime={date.toISOString()}>{dateText}</time>
        {source && <span class="rounded bg-ink-800 px-2 py-0.5">{source}</span>}
        {tags.map((tag) => <span>#{tag}</span>)}
      </div>
      {
        problem && (
          <p class="mt-4 rounded-lg border border-ink-800 bg-ink-900/60 p-3 text-sm text-slate-300">
            <span class="text-slate-500">题面要点：</span>
            {problem}
          </p>
        )
      }
    </header>

    <div class="prose-note mt-6 text-sm leading-relaxed text-slate-300">
      <Content />
    </div>
  </article>
</Layout>
