---
import Layout from '../components/Layout.astro';
import { entries, site } from '../config';
---

<Layout>
  <section class="max-w-2xl">
    <p class="text-xs font-medium tracking-[0.2em] text-accent uppercase">
      Portfolio &amp; Learning Log
    </p>
    <h1 class="mt-3 text-2xl leading-snug font-semibold text-slate-100 sm:text-3xl">
      {site.tagline}
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-slate-400">
      这里放两样东西：算法题的错误复盘（错在哪、为什么错、能迁移到什么模式），
      以及自己写的小工具。都是学习记录，不是产品。
    </p>
  </section>

  <section class="mt-10 grid gap-4 sm:grid-cols-3">
    {
      entries.map((entry) => (
        <a
          href={entry.href}
          class="group flex flex-col rounded-xl border border-ink-800 bg-ink-900/60 p-5 transition-colors hover:border-accent/50 hover:bg-ink-900"
        >
          <span class="text-base font-semibold text-slate-100 group-hover:text-accent-soft">
            {entry.title}
          </span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{entry.summary}</span>
          <span class="mt-4 text-xs text-slate-500">{entry.meta} →</span>
        </a>
      ))
    }
  </section>
</Layout>
