---
import Layout from '../components/Layout.astro';
import { site } from '../config';

// 占位内容：把这几段换成你自己的真实信息即可
const facts = [
  { label: '学校 / 年级', value: 'XX 大学 · 计算机科学与技术 · 大二' },
  { label: '方向', value: '算法基础 + AI 应用' },
  { label: '现在在学', value: '图论与动态规划，顺便把 LLM 用到自己的小工具里' },
];

const skills = [
  { group: '语言', items: ['C++', 'Python', 'TypeScript'] },
  { group: '算法竞赛', items: ['拓扑排序 / 图论', 'BFS / 最短路', '动态规划', '对拍与调试'] },
  { group: '前端与工具', items: ['React', 'Astro', 'Tailwind CSS', 'Git'] },
  { group: 'AI 应用', items: ['提示词与结构化输出', '把 LLM 嵌进自己的工作流'] },
];

const learningLog = [
  {
    period: '2026 上半年',
    text: '把「错误复盘」变成固定的写作结构；开始做 AlgoLens，想把对拍发现的反例可视化。',
  },
  {
    period: '2025 下半年',
    text: '刷图论和搜索，第一次因为「状态没检查」的 bug 丢掉分数，开始重视不变量。',
  },
];
---

<Layout title="关于我" description={`${site.author}：大二计算机学生，方向是算法基础与 AI 应用。`}>
  <header>
    <h1 class="text-xl font-semibold text-slate-100">关于我</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-300">
      我是{site.author}，大二计算机学生。这个站点是我的作品集和学习记录：
      一半是算法的错误复盘，一半是自己写的小工具。我不太喜欢把「学会了什么」写成清单，
      更愿意写清楚「我在哪里栽过跟头」。
    </p>
  </header>

  <section class="mt-8 grid gap-3 sm:grid-cols-3">
    {
      facts.map((fact) => (
        <div class="rounded-lg border border-ink-800 bg-ink-900/40 p-3">
          <p class="text-xs text-slate-500">{fact.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-300">{fact.value}</p>
        </div>
      ))
    }
  </section>

  <section class="mt-8">
    <h2 class="text-base font-semibold text-slate-100">技能</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        skills.map((group) => (
          <div class="rounded-lg border border-ink-800 bg-ink-900/40 p-4">
            <p class="text-xs font-medium tracking-wide text-slate-500">{group.group}</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded bg-ink-800 px-2 py-1 text-xs text-slate-300">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-xs text-slate-500">
      这些是「用过、能自己写出来」的东西，不是熟练度排名。
    </p>
  </section>

  <section class="mt-8">
    <h2 class="text-base font-semibold text-slate-100">最近在做什么</h2>
    <ol class="mt-3 space-y-3 border-l border-ink-800 pl-4">
      {
        learningLog.map((entry) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[21px] h-2 w-2 rounded-full bg-accent" />
            <p class="text-xs text-slate-500">{entry.period}</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-300">{entry.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-8">
    <h2 class="text-base font-semibold text-slate-100">联系方式</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <li class="flex flex-wrap gap-x-3">
        <span class="w-16 text-slate-500">邮箱</span>
        <a class="text-accent-soft underline underline-offset-4" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </li>
      <li class="flex flex-wrap gap-x-3">
        <span class="w-16 text-slate-500">GitHub</span>
        <a class="text-accent-soft underline underline-offset-4" href={site.github} rel="noreferrer">
          {site.github}
        </a>
      </li>
    </ul>
    <p class="mt-3 text-xs text-slate-500">
      这两个还是占位符，换成你自己的就行（改 src/config.ts 一处即可）。
    </p>
  </section>
</Layout>
